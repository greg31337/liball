# Shared ignore rules for the liball .NET library collection.
# Patterns apply at every depth unless anchored with a leading slash.
# Separate Git repositories do not inherit this file; their own rules still apply.
# Ignore rules do not remove files that Git already tracks.

# .NET / MSBuild outputs and NuGet packages
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
[Aa]rtifacts/
[Pp]ublish/
*.nupkg
*.snupkg
*.pdb
*.binlog
*.tlog
*.tmp_proj
*_wpftmp.csproj
project.assets.json
project.nuget.cache
project.lock.json
project.fragment.lock.json
*.csproj.nuget.dgspec.json
*.csproj.nuget.g.props
*.csproj.nuget.g.targets
**/.nuget/packages/
**/.nuget/http-cache/

# Test runs, coverage reports, benchmarks, and diagnostic captures
[Tt]est[Rr]esults/
TestResult.xml
TestResults.xml
nunit-*.xml
*.trx
*.coverage
*.coveragexml
coverage*.xml
coverage*.json
coverage*.info
lcov.info
BenchmarkDotNet.Artifacts/
*.dotCover
*.dotTrace
*.nettrace
*.netperf
*.netdump
*.dmp
*.diagsession
mono_crash.*

# IDE settings and caches specific to a developer or machine
.vs/
.idea/
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.DotSettings.user
*.sln.iml
_ReSharper*/
_NCrunch_*/
nCrunchTemp_*/
.*crunch*.local.xml
**/.vscode/*
!**/.vscode/settings.json
!**/.vscode/tasks.json
!**/.vscode/launch.json
!**/.vscode/extensions.json
!**/.vscode/*.code-snippets
.history/
.localhistory/
.vshistory/
*.swp
*.swo
*~

# Local logs, caches, and scratch work.
# Do not use log/, cache/, reports/, or Generated/: these names contain source
# libraries, implementation code, reference data, or checked-in test fixtures.
*.log
*.log.*
.cache/
.tmp/
.tmp-*/
.codex-tmp/
/tmp/
/temp/
*.tmp
*.temp
*.bak
*.orig
*.rej

# Python helper scripts and local environments; optional Node tooling
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/

# Local environment settings, credentials, and private signing material.
# Keep sanitized templates and shared application / NuGet configuration.
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example
!.env.*.sample
!.env.*.template
.envrc.local
secrets.json
appsettings.Local.json
appsettings.*.local.json
local.settings.json
.aws/
.azure/
.ssh/
*.key
*.pfx
*.p12
*.snk
*-private.pem
*_private.pem
private-key.pem
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.pubxml
*.pubxml.user
*.publishsettings

# Private RAW samples: retain the directory's own ignore policy.
/graphics/raw/corpus/private/*
!/graphics/raw/corpus/private/.gitignore

# macOS / Windows filesystem and archive metadata
.DS_Store
.AppleDouble/
.LSOverride
._*
__MACOSX/
.Spotlight-V100/
.Trashes/
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
~$*

