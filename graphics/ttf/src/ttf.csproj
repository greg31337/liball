<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ttf.Tests" />
    <EmbeddedResource Include="Unicode/UnicodeData.bin"
                      LogicalName="ttf.UnicodeData.bin" />
    <EmbeddedResource Include="Unicode/LanguageTagMap.bin"
                      LogicalName="ttf.LanguageTagMap.bin" />
  </ItemGroup>

</Project>
