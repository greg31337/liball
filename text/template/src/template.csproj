<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>template</PackageId>
    <Version>0.1.0</Version>
    <Authors>template contributors</Authors>
    <Description>A small .NET template engine with native syntax, compatibility profiles, diagnostics, security limits, and tooling.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>template;templating;mustache;handlebars;liquid;jinja</PackageTags>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="template.Tests" />
  </ItemGroup>

</Project>
